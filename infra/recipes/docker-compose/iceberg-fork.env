# docker compose variables for images built from a -PicebergFork build (docs/development/iceberg-fork.md).
# The Iceberg 1.2 / Spark 3.1 projects are not in that build, so the scheduler and Spark images take
# the Spark 3.5 jars, and the Spark image is the Spark 3.5 one on Java 17 with the fork's Iceberg
# runtime inside. Use: docker compose --env-file <this file> -f <recipe>/docker-compose.yml up -d --build
# (`./gradlew -PicebergFork dockerUp` does). Without this file every recipe builds what it always did.

# jobs-scheduler.Dockerfile and the Spark image: build/<name>/libs/<name>-uber.jar
OH_SPARK_APPS_NAME=openhouse-spark-apps-1.5_2.12

# common/spark-services.yml: the image of spark-master, spark-worker-a and spark-livy
OH_SPARK_DOCKERFILE=infra/recipes/docker-compose/common/spark/spark-3.5-base-hadoop3.2.dockerfile
OH_SPARK_BASE=iceberg-fork
# Livy and Spark from stages that use only Docker Hub, GitHub and Maven Central: the default
# builder stage also needs archive.apache.org and Ubuntu's package archive, which made the image's
# build take hours on GitHub's runners. Same Livy commit and Spark release (the dockerfile says more).
OH_SPARK_BUILDER=dockerhub

# The jobs service's job definitions: jobs.yaml without the Iceberg runtime download
OPENHOUSE_JOBS_CONFIG_PATH=/var/config/jobs-iceberg-fork.yaml
