# HDFS cluster config for the oh-hadoop-spark recipe.
# Single-datanode local cluster: default replication of 1 keeps the cluster
# HEALTHY (files written with the Hadoop default replication of 3 would sit
# perpetually under-replicated). The delete-file-replication custom patch is
# validated by requesting a REPLICATION FACTOR that differs from this default
# (see docs/spark4-iceberg-upgrade/docker-hdfs-validation).
HDFS_CONF_dfs_replication=1
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
